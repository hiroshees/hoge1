{
    "name": "my-devcontainer",
    // ユニバーサルデフォルトイメージ
    // "image": "mcr.microsoft.com/devcontainers/universal:linux",
    // 2026年5月現在最新のユニバーサルデフォルトイメージ
    // "image": "mcr.microsoft.com/devcontainers/universal:5",
    // Nodejs24のイメージ
    // "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
    // 備考: imageを省略することで、Codespacesデフォルトの最新イメージ（現在はv5）が適用
    // featuresを利用するとCodespaceの起動が遅くなるので利用しません
    // "features": {
    //   // nodejs
    //   "ghcr.io/devcontainers/features/node:1": {
    //     "version": "latest"
    //   },
    //   // python
    //   "ghcr.io/devcontainers/features/python:1": {
    //     "version": "latest"
    //   },
    //   // utils
    //   "ghcr.io/devcontainers/features/common-utils:2": {
    //     "upgradePackages": true,
    //     "username": "vscode",
    //     "userUid": "automatic",
    //     "userGid": "automatic"
    //   },
    //   "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
    //     "packages": "curl,wget,git,jq,ca-certificates,build-essential"
    //   },
    // },
    // 拡張機能の自動インストールだけを共通化するためにこのファイルを配置します
    "customizations": {
        "vscode": {
            "settings": {},
            "extensions": [
                // material file icon theme
                "pkief.material-icon-theme",
                // Integrates ESLint JavaScript into VS Code.
                "dbaeumer.vscode-eslint",
                // spell checker
                "streetsidesoftware.code-spell-checker",
                // formatter
                "esbenp.prettier-vscode",
                // visible indent
                "oderwat.indent-rainbow",
                // auto tag rename
                "formulahendry.auto-rename-tag",
                // markdown edit
                "yzhang.markdown-all-in-one",
                // markdown enhance
                "shd101wyy.markdown-preview-enhanced",
                // zenkaku highlight
                "mosapride.zenkaku"
            ]
        }
    }
}
